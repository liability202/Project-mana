# Copy to .env.local for local work, and add the same keys in
# Vercel → Settings → Environment Variables for the live site.
# Never commit real values: .env.local was once committed and its keys leaked.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Full database access; server-only. Never expose it or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_INVOICE_BUCKET=order-invoices
SUPABASE_PRODUCT_IMAGE_BUCKET=

# ── Secrets (each a different long random string, e.g. `openssl rand -hex 32`) ──
# Admin panel password (also accepted as a Bearer token by admin APIs).
ADMIN_SECRET=choose_a_strong_admin_secret
# Signs customer and creator login cookies. Changing it signs everyone out.
SESSION_SECRET=choose_a_long_random_secret
# Keys the stored WhatsApp OTP hashes.
OTP_SECRET=choose_another_long_random_secret

# ── Razorpay (Dashboard → Account & Settings → API Keys) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Dashboard → Settings → Webhooks → URL https://<site>/api/razorpay/webhook,
# events: order.paid, payment.captured, payment_link.paid.
RAZORPAY_WEBHOOK_SECRET=choose_the_webhook_secret_you_set_in_razorpay

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_OTP_TEMPLATE_NAME=your_approved_otp_template_name
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_OTP_TEMPLATE_COPY_BUTTON=false
# Meta app → Settings → Basic → App secret. Used to verify incoming webhooks.
WHATSAPP_APP_SECRET=your_meta_app_secret
WEBHOOK_VERIFY_TOKEN=choose_a_random_secret
# A staffed WhatsApp number that receives support-ticket alerts (not the bot's own number).
SUPPORT_ALERT_PHONE=919876543210

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxx
# Must be on a domain verified in Resend; emails are skipped while this is blank.
RESEND_FROM_EMAIL=orders@your-domain.com

# ── WhatsApp bot product advice (optional; canned answers without them) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=999
# Google Search Console HTML-tag verification code (the `content` value only).
GOOGLE_SITE_VERIFICATION=

# ── NimbusPost shipping ──
NIMBUSPOST_API_KEY=
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=
NIMBUSPOST_PICKUP_LOCATION=
NIMBUSPOST_PICKUP_POSTCODE=
NIMBUSPOST_FALLBACK_EMAIL=orders@your-domain.com
NIMBUSPOST_BASE_URL=https://api.nimbuspost.com/v1
# Optional endpoint overrides; leave blank for the defaults.
NIMBUSPOST_AUTH_PATH=
NIMBUSPOST_SERVICEABILITY_PATH=
NIMBUSPOST_CREATE_SHIPMENT_PATH=
NIMBUSPOST_ASSIGN_AWB_PATH=
NIMBUSPOST_PICKUP_PATH=
NIMBUSPOST_TRACKING_PATH=

# ── Local development only ──
# Creator-portal test login that skips OTP. Ignored in production.
CREATOR_TEST_PHONE=
